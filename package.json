{
  "name": "bow-decision-challenges",
  "private": true,
  "version": "2.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && npm run build:server",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . && stylelint \"src/**/*.css\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --project=chromium-1366 --project=chromium-1024",
    "walkthrough": "playwright test --project=walkthrough",
    "balance": "BALANCE_REPORT=balance-report.txt vitest run src/domain/scenario/balance.test.ts",
    "build:server": "vite build --ssr server/index.ts --outDir dist-server",
    "api": "npm run build:server && node dist-server/index.js",
    "api:dev": "npm run build:server && BOW_CLASS_STORE=memory node dist-server/index.js",
    "rekey": "npm run build:rekey && node dist-server/rekey.js",
    "build:rekey": "vite build --ssr server/rekey.ts --outDir dist-server --emptyOutDir false"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "vite": "latest"
  },
  "devDependencies": {
    "@axe-core/playwright": "latest",
    "@eslint/js": "latest",
    "@playwright/test": "latest",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@testing-library/user-event": "latest",
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "jsdom": "latest",
    "stylelint": "latest",
    "stylelint-config-standard": "latest",
    "typescript": "latest",
    "typescript-eslint": "latest",
    "vitest": "latest"
  }
}
