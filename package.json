{
  "name": "bow-decision-challenges",
  "private": true,
  "version": "2.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && npm run build:server",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . && stylelint \"src/**/*.css\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --project=chromium-1366 --project=chromium-1024",
    "walkthrough": "playwright test --project=walkthrough",
    "balance": "BALANCE_REPORT=balance-report.txt vitest run src/domain/scenario/balance.test.ts",
    "build:server": "vite build --ssr server/index.ts --outDir dist-server",
    "api": "npm run build:server && node dist-server/index.js",
    "api:dev": "npm run build:server && BOW_CLASS_STORE=memory node dist-server/index.js",
    "rekey": "npm run build:rekey && node dist-server/rekey.js",
    "build:rekey": "vite build --ssr server/rekey.ts --outDir dist-server --emptyOutDir false"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.0.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "7.18.2",
    "vite": "8.2.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.3",
    "@types/node": "26.2.0",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "eslint": "10.8.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "globals": "17.10.0",
    "jsdom": "30.0.1",
    "stylelint": "17.14.1",
    "stylelint-config-standard": "40.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10"
  }
}
