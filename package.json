{
  "name": "bow-decision-challenges",
  "private": true,
  "version": "2.2.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && npm run build:server",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . && stylelint \"src/**/*.css\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --project=chromium-1366 --project=chromium-1024",
    "walkthrough": "playwright test --project=walkthrough",
    "balance": "BALANCE_REPORT=balance-report.txt vitest run src/domain/scenario/balance.test.ts",
    "budget": "npm run build && node scripts/asset-budget.mjs",
    "build:server": "vite build --ssr server/index.ts --outDir dist-server",
    "api": "npm run build:server && node dist-server/index.js",
    "api:dev": "npm run build:server && BOW_CLASS_STORE=memory node dist-server/index.js",
    "rekey": "npm run build:rekey && node dist-server/rekey.js",
    "build:rekey": "vite build --ssr server/rekey.ts --outDir dist-server --emptyOutDir false",
    "seed:demo": "npm run build:seed && node dist-server/seed-demo.js",
    "test:lab:check": "npm run build:test-lab && node dist-server/test-lab-check.js",
    "build:test-lab": "vite build --ssr scripts/test-lab-check.ts --outDir dist-server --emptyOutDir false",
    "build:seed": "vite build --ssr scripts/seed-demo.ts --outDir dist-server --emptyOutDir false",
    "demo:app": "vite --host 127.0.0.1 --port ${BOW_APP_PORT:-4361} --strictPort",
    "demo:health": "node -e \"const p=process.env.BOW_API_PORT||4360;fetch('http://127.0.0.1:'+p+'/api/health').then(r=>r.json()).then(h=>{console.log(JSON.stringify(h,null,2));process.exitCode=h.ok&&h.classroomReady?0:1;}).catch(e=>{console.error('No class service on port '+p+': '+e.message);process.exitCode=1;})\""
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.0.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "7.18.2",
    "vite": "8.2.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.3",
    "@types/node": "26.2.0",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "eslint": "10.8.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "globals": "17.10.0",
    "jsdom": "30.0.1",
    "stylelint": "17.14.1",
    "stylelint-config-standard": "40.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10"
  }
}
